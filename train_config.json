{
  "data_dir": "data/PlantVillage",
  "models_dir": "models",
  "logs_dir": "logs",

  "training": {
    "batch_size": 32,
    "num_epochs": 50,
    "num_workers": 4,
    "early_stopping_patience": 10,
    "save_best_only": true
  },

  "image_preprocessing": {
    "image_size": 224,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  },

  "models": {
    "baseline": {
      "name": "baseline_model",
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "description": "Simple CNN, fast training, good for quick experiments"
    },
    "efficientnet": {
      "name": "efficientnet_model",
      "learning_rate": 0.0001,
      "weight_decay": 0.0001,
      "description": "EfficientNet-B0, high accuracy, uses ImageNet pretrained weights"
    },
    "mobilenet": {
      "name": "mobilenet_model",
      "learning_rate": 0.0001,
      "weight_decay": 0.0001,
      "description": "MobileNetV2, lightweight, suitable for mobile deployment"
    },
    "hybrid": {
      "name": "hybrid_model",
      "learning_rate": 0.00005,
      "weight_decay": 0.0001,
      "description": "CNN + Transformer, highest accuracy, slower training"
    }
  },

  "data_augmentation": {
    "horizontal_flip": 0.5,
    "vertical_flip": 0.3,
    "rotation_degrees": 30,
    "color_jitter": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.1
    },
    "random_affine": {
      "translate": [0.1, 0.1],
      "scale": [0.9, 1.1]
    }
  },

  "optimizer": {
    "type": "Adam",
    "weight_decay": 0.0001
  },

  "scheduler": {
    "type": "ReduceLROnPlateau",
    "mode": "min",
    "factor": 0.5,
    "patience": 5
  }
}
